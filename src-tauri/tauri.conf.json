{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "serwis-ai",
  "version": "0.1.0",
  "identifier": "com.serwisai.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Serwis AI",
        "width": 960,
        "height": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:serwis-ai.db"]
    },
    "shell": {
      "open": "^(https?://|mailto:|tel:|file://|/|[a-zA-Z]:[/\\\\]).*$"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
