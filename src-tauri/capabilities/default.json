{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "shell:default",
    "shell:allow-open",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "xdg-open-dir",
          "cmd": "xdg-open",
          "args": [{ "validator": "^.+$" }],
          "sidecar": false
        },
        {
          "name": "vbox-list-running",
          "cmd": "VBoxManage",
          "args": ["list", "runningvms"],
          "sidecar": false
        },
        {
          "name": "vbox-start",
          "cmd": "VBoxManage",
          "args": ["startvm", "Serwis_Win10", "--type", "headless"],
          "sidecar": false
        },
        {
          "name": "vbox-run-boardview",
          "cmd": "VBoxManage",
          "args": [
            "guestcontrol",
            "Serwis_Win10",
            "start",
            "--username",
            "vboxuser",
            "--domain",
            ".",
            "--password",
            "vboxuser",
            "--exe",
            { "validator": "^.+$" },
            "--",
            { "validator": "^.+$" },
            { "validator": "^.+$" }
          ],
          "sidecar": false
        }
      ]
    },
    "sql:default",
    "sql:allow-execute",
    "dialog:default",
    "dialog:allow-open"
  ]
}
